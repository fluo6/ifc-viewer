ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('i-beam.ifc','2026-01-01T00:00:00',('test'),('test'),'1.0','fixture','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=IFCPERSON('tester',$,'Tester',$,$,$,$,$);
#2=IFCORGANIZATION($,'Fixtures',$,$,$);
#3=IFCPERSONANDORGANIZATION(#1,#2,$);
#4=IFCAPPLICATION(#2,'1.0','Fixture','FIX');
#5=IFCOWNERHISTORY(#3,#4,$,.NOCHANGE.,0,$,$,0);
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT('Project World','Model',3,$,#13,$);
#15=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#16=IFCSIUNIT(*,.AREAUNIT.,.MICRO.,.SQUARE_METRE.);
#17=IFCSIUNIT(*,.VOLUMEUNIT.,.NANO.,.CUBIC_METRE.);
#18=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#19=IFCSIUNIT(*,.PRESSUREUNIT.,.MEGA.,.PASCAL.);
#20=IFCUNITASSIGNMENT((#15,#16,#17,#18,#19));
#21=IFCPROJECT('1Project00000000000000',#5,'Fixture Project',$,$,$,$,(#14),#20);
#22=IFCSITE('1Site000000000000000000',#5,'Site',$,$,#30,$,$,.ELEMENT.,$,$,$,$,$);
#23=IFCBUILDING('1Building0000000000000',#5,'Building',$,$,#31,$,$,.ELEMENT.,$,$,$);
#24=IFCBUILDINGSTOREY('1Storey00000000000000',#5,'Level 1',$,$,#32,$,$,.ELEMENT.,0.);
#25=IFCRELAGGREGATES('1AggProjSite000000000',#5,$,$,#21,(#22));
#26=IFCRELAGGREGATES('1AggSiteBldg000000000',#5,$,$,#22,(#23));
#27=IFCRELAGGREGATES('1AggBldgStorey0000000',#5,$,$,#23,(#24));
#30=IFCLOCALPLACEMENT($,#13);
#31=IFCLOCALPLACEMENT(#30,#13);
#32=IFCLOCALPLACEMENT(#31,#13);
/* Beam: 200UB25.4-like I section, extruded 5000 mm along +Z from (1000,2000,3000) */
#40=IFCCARTESIANPOINT((1.000000E+003,2.000000E+003,3.000000E+003));
#41=IFCAXIS2PLACEMENT3D(#40,#11,#12);
#42=IFCLOCALPLACEMENT(#32,#41);
#43=IFCCARTESIANPOINT((0.,0.));
#44=IFCAXIS2PLACEMENT2D(#43,$);
#45=IFCISHAPEPROFILEDEF(.AREA.,'200UB25.4',#44,1.330000E+002,2.030000E+002,5.800000E+000,7.800000E+000,$);
#46=IFCEXTRUDEDAREASOLID(#45,#13,#11,5.000000E+003);
#47=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#46));
#48=IFCPRODUCTDEFINITIONSHAPE($,$,(#47));
#49=IFCBEAM('1Beam00000000000000000',#5,'B1',$,'UB',#42,#48,'TAG-1');
#50=IFCRELCONTAINEDINSPATIALSTRUCTURE('1ContainStorey0000000',#5,$,$,(#49),#24);
/* Material with extended properties */
#60=IFCMATERIAL('Steel_Grade_300');
#61=IFCPROPERTYSINGLEVALUE('YieldStress',$,IFCPRESSUREMEASURE(3.000000E+002),#19);
#62=IFCPROPERTYSINGLEVALUE('PoissonRatio',$,IFCRATIOMEASURE(3.000000E-001),$);
#63=IFCEXTENDEDMATERIALPROPERTIES(#60,(#61,#62),$,'Steel_Grade_300');
#64=IFCRELASSOCIATESMATERIAL('1AssocMaterial0000000',#5,$,$,(#49),#60);
/* Section properties keyed on the profile definition */
#70=IFCSTRUCTURALPROFILEPROPERTIES('200UB25.4',#45,$,$,$,$,3.200000E+003,6.200000E+004,$,2.360000E+007,1.550000E+006,$,$,$,$,$,$,$,$,$,$,$,$);
/* A real property set, so the pset branch is covered too */
#80=IFCPROPERTYSINGLEVALUE('Reference',$,IFCLABEL('200UB25.4'),$);
#81=IFCPROPERTYSINGLEVALUE('LoadBearing',$,IFCBOOLEAN(.T.),$);
#82=IFCPROPERTYSET('1Pset000000000000000',#5,'Pset_BeamCommon',$,(#80,#81));
#83=IFCRELDEFINESBYPROPERTIES('1DefinesByProps000000',#5,$,$,(#49),#82);
ENDSEC;
END-ISO-10303-21;
